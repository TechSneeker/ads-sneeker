# ── Supabase ──
# Painel do projeto Supabase → Settings → API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui

# ── Google Gemini ──
# Chave padrão da aplicação (cada usuário também pode cadastrar a própria chave pela UI).
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_gemini_api_key_aqui

# ── Criptografia ──
# Salt usado para derivar a chave AES-256-GCM que protege a chave Gemini de cada usuário.
# Use uma string longa e aleatória (ex.: `openssl rand -hex 32`).
ENCRYPTION_SALT=uma_string_aleatoria_longa_e_secreta
